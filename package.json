    "sim": "vitest run tests/balance.sim.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/forum": "^5.3.0"
  }

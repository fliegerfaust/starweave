{
  "name": "starweave",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Starweave — карточный рогалик-головоломка о созвездиях",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
